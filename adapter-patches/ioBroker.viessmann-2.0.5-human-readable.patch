+                                    iobrokerUnit: 'kWh',
+                                    iobrokerMin: '0',
+                                    iobrokerMax: '999999',
+                                    iobrokerFactorState: 'EnergieFaktor',
+                                    iobrokerFactorMultiplier: '0.1',
+                                },
+                                unit: ['CO'],
+                                description: ['Elektrische Energie Warmwasser'],
+                            },
+                            {
+                                $: {
+                                    name: 'getStatusHeizstabSt1',
+                                    iobrokerStates: '{"0":"Aus","1":"Ein"}',
+                                },
+                                unit: ['RT'],
+                            },
+                        ],
+                    },
+                ],
+            },
+        };
+
+        const result = await adapter.getImport(
+            xml,
+            { CO: { unit: '' }, RT: { unit: '' } },
