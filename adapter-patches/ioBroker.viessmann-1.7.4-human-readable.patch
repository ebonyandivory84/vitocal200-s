+    validateWriteRequest(id, rawValue) {
+        const prefix = `${this.namespace}.set.`;
+        if (!String(id).startsWith(prefix)) {
+            return { ok: false, code: 'NOT_A_SET_STATE' };
+        }
+
+        const name = String(id).slice(prefix.length);
+        const item =
+            this.config.datapoints?.sets?.[name] ||
