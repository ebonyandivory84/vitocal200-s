+        assert.equal(adapter.validateWriteRequest('viessmann.0.set.BetriebsartExternHK1', 13).ok, true);
+        assert.equal(adapter.validateWriteRequest('viessmann.0.set.BetriebsartExternHK1', 255).ok, true);
+        assert.equal(
+            adapter.validateWriteRequest('viessmann.0.set.BetriebsartExternHK1', 8).code,
+            'VALUE_NOT_WHITELISTED',
+        );
+        assert.equal(adapter.validateWriteRequest('viessmann.0.set.WWBetriebsartExtern', 1).ok, true);
+        assert.equal(adapter.validateWriteRequest('viessmann.0.set.WWBetriebsartExtern', 255).ok, true);
+        assert.equal(
+            adapter.validateWriteRequest('viessmann.0.set.WWBetriebsartExtern', 6).code,
+            'VALUE_NOT_WHITELISTED',
+        );
+    });
+
+    it('enforces integer-only temperature ranges', () => {
+        const adapter = adapterWithSets();
+
+        assert.equal(adapter.validateWriteRequest('viessmann.0.set.RaumsollExternHK1', 18).ok, true);
+        assert.equal(adapter.validateWriteRequest('viessmann.0.set.RaumsollExternHK1', '20').ok, true);
+        assert.equal(adapter.validateWriteRequest('viessmann.0.set.RaumsollExternHK1', 24).ok, true);
+        assert.equal(
+            adapter.validateWriteRequest('viessmann.0.set.RaumsollExternHK1', true).code,
+            'VALUE_TYPE_NOT_SUPPORTED',
+        );
+        assert.equal(
+            adapter.validateWriteRequest('viessmann.0.set.RaumsollExternHK1', 25).code,
+            'VALUE_OUTSIDE_SAFE_RANGE',
