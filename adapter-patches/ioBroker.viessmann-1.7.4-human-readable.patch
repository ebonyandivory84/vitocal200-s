+    async formatReadValue(value, poll) {
+        const trimmed = String(value).trim();
+        if (poll.type !== 'number') {
+            return trimmed;
+        }
+
+        const valueWithoutUnit = this.split_unit(trimmed);
+        const parsed = Number.parseFloat(valueWithoutUnit);
+        if (!Number.isFinite(parsed)) {
+            this.log.warn(`Cannot parse numeric reply for ${poll.name}: ${trimmed}`);
+            return undefined;
+        }
+
+        let result = parsed;
+        if (Number.isFinite(poll.scale)) {
+            result *= poll.scale;
+        }
+        if (poll.factorState) {
+            let factor = this.parseOptionalNumber(this.lastValues.get(poll.factorState));
+            if (!(factor > 0)) {
+                const factorState = await this.getStateAsync(`get.${poll.factorState}`);
+                factor = this.parseOptionalNumber(factorState && factorState.val);
+            }
+            if (!(factor > 0)) {
+                this.log.warn(`Cannot scale ${poll.name}: factor state ${poll.factorState} is unavailable`);
+                return undefined;
+            }
+            result *= factor * (poll.factorMultiplier ?? 1);
+        }
+
+        return this.roundNumber(result, 3);
+    }
