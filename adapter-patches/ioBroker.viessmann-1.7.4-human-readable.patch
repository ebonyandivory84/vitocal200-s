+        assert.equal(
+            adapter.validateWriteRequest('viessmann.0.set.VorlaufsollExternHK1', 30.5).code,
+            'INTEGER_REQUIRED',
+        );
+        assert.equal(adapter.validateWriteRequest('viessmann.0.set.VorlaufsollExternHK1', 45).ok, true);
+        assert.equal(adapter.validateWriteRequest('viessmann.0.set.WWSollExtern', 50).ok, true);
+        assert.equal(
+            adapter.validateWriteRequest('viessmann.0.set.WWSollExtern', 51).code,
+            'VALUE_OUTSIDE_SAFE_RANGE',
+        );
+    });
+
+    it('blocks unknown commands and XML address mismatches', () => {
