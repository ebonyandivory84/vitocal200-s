+        if (!item) {
+            return { ok: false, code: 'UNKNOWN_SET_STATE' };
+        }
+
+        const policy = WRITE_POLICIES[item.command];
+        if (!policy) {
+            return { ok: false, code: 'COMMAND_NOT_WHITELISTED' };
+        }
+        if (String(item.address || '').toUpperCase() !== policy.address) {
+            return { ok: false, code: 'ADDRESS_POLICY_MISMATCH' };
+        }
+        if (typeof rawValue !== 'number' && typeof rawValue !== 'string') {
+            return { ok: false, code: 'VALUE_TYPE_NOT_SUPPORTED' };
+        }
+        if (rawValue === null || rawValue === undefined || (typeof rawValue === 'string' && rawValue.trim() === '')) {
+            return { ok: false, code: 'VALUE_REQUIRED' };
+        }
+
+        const value = Number(rawValue);
+        if (!Number.isInteger(value)) {
+            return { ok: false, code: 'INTEGER_REQUIRED' };
+        }
+        if (policy.allowedValues && !policy.allowedValues.includes(value)) {
+            return { ok: false, code: 'VALUE_NOT_WHITELISTED' };
+        }
+        if (policy.min !== undefined && (value < policy.min || value > policy.max)) {
+            return { ok: false, code: 'VALUE_OUTSIDE_SAFE_RANGE' };
+        }
+
+        const lastWrite = this.lastSetWrites.get(item.command);
+        if (lastWrite !== undefined && Date.now() - lastWrite < MIN_SET_INTERVAL_MS) {
+            return { ok: false, code: 'RATE_LIMITED' };
+        }
+
+        return {
+            ok: true,
+            code: 'WRITE_VALIDATED',
+            command: item.command,
+            name: item.name,
+            address: policy.address,
+            value,
+        };
